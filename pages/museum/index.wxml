<view class="museum-container" bindtouchstart="touchStart" bindtouchend="touchEnd">
  <!-- 动态模糊背景 -->
  <image class="bg-blur" src="{{photos[currentIndex].url}}" mode="aspectFill"></image>
  <view class="bg-mask"></view>

  <!-- 顶部设计：标题与副标题 -->
  <view class="header">
    <text class="title">云游村史馆</text>
    <text class="subtitle">EXPERIENCE THE HISTORY</text>
  </view>

  <!-- 轮播图片区域：平滑 -->
  <view class="carousel-wrapper"
    style="transition-duration: {{transitionDuration}}ms; transform: translateX(-{{currentIndex * 100}}vw)">
    <view class="carousel-slide" wx:for="{{photos}}" wx:key="id" bindtap="toggleAutoplay">
      <view class="image-box">
        <image src="{{item.url}}" mode="aspectFit" class="slide-image" lazy-load="true"></image>
        <view class="photo-title" wx:if="{{item.title}}">{{item.title}}</view>
      </view>
    </view>
  </view>

  <!-- 左右切换图标（优化为极简箭头） -->
  <view class="control-btn prev" bindtap="prevSlide">
    <view class="arrow left"></view>
  </view>
  <view class="control-btn next" bindtap="nextSlide">
    <view class="arrow right"></view>
  </view>

  <!-- 底部交互与指示器区域 -->
  <view class="footer">
    <!-- 高级数字指示器 -->
    <view class="custom-indicator">
      <text class="current-num">{{currentIndex < 9 ? '0' + (currentIndex + 1) : currentIndex + 1}}</text>
          <text class="divider">/</text>
          <text class="total-num">{{photos.length}}</text>
    </view>

    <!-- 音频与预约按钮（毛玻璃质感） -->
    <view class="action-group">
      <view class="action-btn btn-audio {{isPlaying ? 'playing' : ''}}" bindtap="playAudioFor"
        data-index="{{currentIndex + 1}}">
        <view class="icon-audio">
          <view class="bar"></view>
        </view>
        <text>{{isPlaying ? '暂停讲解' : '播放讲解'}}</text>
      </view>
      <view class="action-btn btn-booking" bindtap="goToBooking">
        <text>预约参观</text>
      </view>
    </view>
  </view>
</view>